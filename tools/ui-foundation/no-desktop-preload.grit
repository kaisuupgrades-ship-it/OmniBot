language js(typescript)

or {
  `window.omnibot`,
  `window?.omnibot`,
  `window["omnibot"]`,
  `window?.["omnibot"]`,
  `globalThis.omnibot`,
  `globalThis?.omnibot`,
  `globalThis["omnibot"]`,
  `globalThis?.["omnibot"]`
} as $access where {
  register_diagnostic(span=$access, message="Shared UI must receive platform actions through props, not the desktop preload.", severity="error")
}
