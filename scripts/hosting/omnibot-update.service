# Downloads and unpacks a newer OmniBot release next to the running one. omnibot-update.timer starts
# it; omnibot-update-apply.service moves the release into place at the next start of the server.
[Unit]
Description=Stage an OmniBot update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/OmniBot/hosted/omnibot-hosted-update stage
Nice=19
IOSchedulingClass=idle
CPUWeight=idle
TimeoutStartSec=30min
