# boat stop and resume work like a reboot. This moves a staged release into place before OmniBot
# starts, so an update never stops work in progress. While boat still restores the disk after a wake,
# the release stays, and OmniBot asks for the install when no client uses it. OmniBot does not require
# this unit, so it starts after a failure too. The next boot does the update again.
[Unit]
Description=Apply a staged OmniBot update
Before=omnibot.service

[Service]
Type=oneshot
# omnibot.service wants this unit, and boat starts each enabled unit after a wake too. The second
# start must not copy a release under a running OmniBot.
RemainAfterExit=yes
ExecStart=/opt/OmniBot/hosted/omnibot-hosted-update boot
# At most 4 minutes of restore wait when a stop interrupted a copy, then the copy.
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
