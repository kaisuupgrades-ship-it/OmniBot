# Applies the firewall of the OmniBot instances before Docker starts their containers.
# `omnibot-instance setup` installs it. See docs/docker.md#several-instances-on-one-host.
[Unit]
Description=Firewall of the OmniBot Docker instances
After=ufw.service
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/omnibot-docker/instances/omnibot-firewall

[Install]
WantedBy=multi-user.target docker.service
