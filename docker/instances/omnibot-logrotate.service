# Rotates the container logs of the OmniBot instances. omnibot-logrotate.timer starts it.
# `omnibot-instance setup` installs it. See docs/docker.md#logs.
[Unit]
Description=Rotate the container logs of the OmniBot instances

[Service]
Type=oneshot
ExecStart=/usr/sbin/logrotate --state /var/lib/logrotate/omnibot-docker.status /etc/omnibot-docker/logrotate.conf
