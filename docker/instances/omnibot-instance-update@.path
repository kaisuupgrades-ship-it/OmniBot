# The app of instance %i asks for an update with an empty file in update-requests.
# `omnibot-instance start` enables this unit for each instance.
[Unit]
Description=Update requests of OmniBot instance %i

[Path]
PathExists=/srv/omnibot/%i/update-requests/update-stage
PathExists=/srv/omnibot/%i/update-requests/update-install

[Install]
WantedBy=paths.target
