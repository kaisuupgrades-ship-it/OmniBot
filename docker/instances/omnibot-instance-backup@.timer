# A daily backup of instance %i. Enable it with
# `systemctl enable --now omnibot-instance-backup@<name>.timer`, and change the time with
# `systemctl edit omnibot-instance-backup@<name>.timer`.
[Unit]
Description=Daily backup of OmniBot instance %i

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
