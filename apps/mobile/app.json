{
  "expo": {
    "name": "OmniBot",
    "slug": "openbot",
    "platforms": ["ios", "android"],
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "omnibot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "run.openbot.mobile",
      "associatedDomains": ["applinks:omnibot.example.com"],
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow OmniBot to connect to your desktop during local development.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icons/app-icon.icon"
    },
    "android": {
      "package": "run.openbot.mobile",
      "icon": "./assets/icons/app-icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "./plugins/with-rocketsim",
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6C5FA",
          "image": "./assets/icons/app-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181818"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OmniBot to use your camera to scan QR codes.",
          "microphonePermission": "Allow OmniBot to use the microphone to dictate messages.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OmniBot to access the photos you choose to share.",
          "cameraPermission": "Allow OmniBot to use your camera to add photos.",
          "microphonePermission": "Allow OmniBot to use the microphone to dictate messages."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OmniBot to access the photos you choose to share.",
          "savePhotosPermission": "Allow OmniBot to save images and videos you download from a chat to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#6960F1"
        }
      ],
      [
        "./plugins/with-notification-sounds",
        {
          "sounds": [
            "./assets/sounds/openbot-task.wav",
            "./assets/sounds/openbot-warm.wav",
            "./assets/sounds/openbot-mech.wav",
            "./assets/sounds/openbot-bubble.wav",
            "./assets/sounds/openbot-press.wav"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "./plugins/with-share-target",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.run.openbot.mobile",
            "extensionBundleIdentifier": "run.openbot.mobile.ShareExtension",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsFileWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/*", "image/*", "application/*"],
            "multipleShareMimeTypes": ["*/*"]
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow OmniBot to use the microphone to dictate messages.",
          "speechRecognitionPermission": "Allow OmniBot to turn your speech into message text."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "run.openbot.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.run.openbot.mobile",
          "enablePushNotifications": true,
          "frequentUpdates": true
        }
      ],
      [
        "./plugins/with-notification-service",
        {
          "targetName": "OmniBotNotificationService",
          "bundleIdentifier": "run.openbot.mobile.NotificationService",
          "groupIdentifier": "group.run.openbot.mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eeec730f-c8f4-42c0-a750-64df8af14940"
      }
    },
    "owner": "openbot",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/eeec730f-c8f4-42c0-a750-64df8af14940"
    }
  }
}
