{
  "display_information": {
    "name": "OmniBot (dev)",
    "description": "Your OmniBot agents in Slack. Mention @OmniBot or send it a direct message."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "OmniBot",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://omnibot-auth-api-test.internal9671.workers.dev/v2/slack/callback"],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:join",
        "channels:read",
        "chat:write",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://signal.omnibot.example.com/v1/slack/events",
      "bot_events": [
        "app_mention",
        "channel_created",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "app_uninstalled",
        "tokens_revoked"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://signal.omnibot.example.com/v1/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
